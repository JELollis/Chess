[Unit]
Description=Aether Chess web application
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=aether-chess
Group=aether-chess
WorkingDirectory=/srv/aether-chess/current
EnvironmentFile=/etc/aether-chess/aether-chess.env
Environment=PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aether-chess

[Install]
WantedBy=multi-user.target
