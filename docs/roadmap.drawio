<mxfile host="app.diagrams.net">
  <diagram name="Aether Chess Roadmap" id="aether-roadmap">
    <mxGraphModel dx="2514" dy="777" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#0B3D52;" value="AETHER CHESS — Process Roadmap to Commercial Launch" vertex="1">
          <mxGeometry height="40" width="520" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="cross" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#333333;dashed=1;" value="&lt;b&gt;CROSS-CUTTING (every phase)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Engine ALWAYS client-side (no server compute)&lt;br&gt;• Offline-first; local storage is source of truth&lt;br&gt;• Primary production: split Ubuntu stack in Azure — application / web server plus a separate MySQL server&lt;br&gt;• Backup / DR: Ubuntu LAMP VM hosted on a friend’s Proxmox server&lt;br&gt;• Keep deployment portable across both environments; automate backups and test restores / failover&lt;br&gt;• COOP/COEP headers for multi-thread WASM (web)&lt;br&gt;• Account security &amp; privacy / GDPR&lt;br&gt;• Stable, versioned, sandboxed mod API&lt;br&gt;• CI + automated tests&lt;br&gt;• Error monitoring &amp; analytics" vertex="1">
          <mxGeometry height="1620" width="220" x="-50" y="230" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#D5E8D4;strokeColor=#2E7D32;fontColor=#1B5E20;" value="&lt;b&gt;CURRENT STATE ✓ (shipped)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Free web game, improved JS engine (PST + ordering + mate scoring)&lt;br&gt;• Difficulty tiers: Casual / Club / Expert&lt;br&gt;• Optional clock, difficulty overlay, new-game menu&lt;br&gt;• ELO rating + records + game history &amp; review (localStorage)&lt;br&gt;• Unplugged D1 leaderboard prototype (schema + API) — to be adapted for MySQL&lt;br&gt;• Committed &amp; pushed to private GitHub" vertex="1">
          <mxGeometry height="130" width="440" x="340" y="90" as="geometry" />
        </mxCell>
        <mxCell id="p0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#1565C0;fontColor=#0D47A1;" value="&lt;b&gt;PHASE 0 · Web Worker engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;Foundation — unblocks everything engine&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: move search off the UI thread into a Worker; clean message protocol; UI never freezes.&lt;br&gt;Requirements: refactor engine into a worker module; Vite worker build (already supported)." vertex="1">
          <mxGeometry height="120" width="440" x="340" y="260" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#1565C0;fontColor=#0D47A1;" value="&lt;b&gt;PHASE 1 · Stockfish strength + engine abstraction&lt;/b&gt;&lt;br&gt;&lt;i&gt;Headline feature AND the modding seam&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: integrate stockfish.wasm in the Worker; &lt;b&gt;engine abstraction / UCI protocol layer&lt;/b&gt; (swap JS ↔ Stockfish ↔ any UCI engine); map difficulty → UCI_Elo/Skill; GM tier + more tiers/personalities.&lt;br&gt;Requirements: WASM assets on CDN; COOP/COEP (web); single-thread fallback (iOS/mobile). &lt;i&gt;This UCI layer is what later enables engine mods (Phase 6).&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="340" y="410" as="geometry" />
        </mxCell>
        <mxCell id="gate1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;" value="&lt;b&gt;GATE&lt;/b&gt;&lt;br&gt;Strength &amp; UX good enough to sell?" vertex="1">
          <mxGeometry height="100" width="240" x="440" y="610" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E1D5E7;strokeColor=#7B1FA2;fontColor=#4A148C;" value="&lt;b&gt;PHASE 2 · Accounts &amp; identity&lt;/b&gt;&lt;br&gt;&lt;i&gt;The backend foundation everything else hangs on&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: token-based auth (email + Sign in with Apple/Google); accounts table linked to players.&lt;br&gt;Requirements: session/token security, account recovery, privacy/GDPR.&lt;br&gt;⚠ Build only when ready to ship leaderboard OR paid tier." vertex="1">
          <mxGeometry height="140" width="440" x="340" y="740" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E1D5E7;strokeColor=#7B1FA2;fontColor=#4A148C;" value="&lt;b&gt;PHASE 3 · Global leaderboard + sync&lt;/b&gt;&lt;br&gt;&lt;i&gt;Parallel track A (needs Phase 2)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: adapt the existing /api/games + /api/leaderboard prototype to the separate Azure Ubuntu MySQL server; localStorage ↔ server sync.&lt;br&gt;Requirements: MySQL schema + versioned migrations, private TLS-protected database connectivity, least-privilege application account, connection pooling, automated backups, offline-first idempotent submission, and conflict resolution." vertex="1">
          <mxGeometry height="150" width="360" x="200" y="920" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFE6CC;strokeColor=#E65100;fontColor=#BF360C;" value="&lt;b&gt;PHASE 4 · Monetization (paid unlock)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Parallel track B (needs Phase 2 + Phase 1 content)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: Lemon Squeezy (Merchant of Record), website-only checkout; entitlements table; license-key → account flag; gate premium models/tiers.&lt;br&gt;Requirements: MoR account, webhook endpoint, authenticated download of premium AI assets, free/paid feature gating in all clients." vertex="1">
          <mxGeometry height="150" width="360" x="600" y="920" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#D0F0F5;strokeColor=#00838F;fontColor=#006064;" value="&lt;b&gt;PHASE 5 · Multi-client packaging&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Web → PWA (installable, offline)&lt;br&gt;• Desktop → Steam via Tauri (light) or Electron; Steamworks ownership check&lt;br&gt;• Mobile → PWA-first (avoids store anti-steering); native only if warranted&lt;br&gt;Requirements: packaging pipeline, app signing, Steam partner account, store assets. Each client honors the account entitlement." vertex="1">
          <mxGeometry height="150" width="440" x="340" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="p6mod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" value="&lt;b&gt;PHASE 6 · Modding SDK &amp; community&lt;/b&gt;&lt;br&gt;&lt;i&gt;Builds on the Phase 1 UCI/engine-abstraction layer&lt;/i&gt;&lt;br&gt;&lt;br&gt;Deliverables: &lt;b&gt;UCI engine plug-ins&lt;/b&gt; (drop in any UCI engine → instant AI mods); theming SDK (board / piece / sound packs via a manifest); documented mod API + loader; distribution via &lt;b&gt;Steam Workshop&lt;/b&gt; + a web mod registry.&lt;br&gt;Requirements: stable versioned mod API; sandboxed execution of third-party code (Worker isolation on web, process isolation on desktop); content moderation for the registry; docs + sample mods; decide free vs paid moddability (keep base moddable to grow community)." vertex="1">
          <mxGeometry height="180" width="440" x="340" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="p6b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4EC;strokeColor=#AD1457;fontColor=#880E4F;dashed=1;" value="&lt;b&gt;Learn Chess / tutorial&lt;/b&gt; &lt;i&gt;(optional, any time after Phase 1)&lt;/i&gt;&lt;br&gt;Guided lessons + puzzles. Free hook or part of the paid tier." vertex="1">
          <mxGeometry height="80" width="440" x="340" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="p7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#D0F0F5;strokeColor=#00838F;fontColor=#006064;" value="&lt;b&gt;PHASE 7 · Hosting, launch &amp; operations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Primary — split Ubuntu stack in Azure:&lt;/b&gt; deploy the web app, APIs, identity, entitlements, premium assets, and mod registry to the Ubuntu application / web server. Store account, leaderboard, purchase, and registry data on the separate Ubuntu MySQL server over a private, TLS-protected connection with least-privilege credentials.&lt;br&gt;&lt;b&gt;Backup / DR:&lt;/b&gt; maintain a deployment-ready Ubuntu LAMP environment on the friend-hosted Proxmox server. Automate encrypted off-site MySQL backups, point-in-time recovery where practical, application/configuration restore, secrets recovery, health checks, DNS / TLS failover runbooks, and scheduled recovery tests.&lt;br&gt;&lt;b&gt;Portability:&lt;/b&gt; replace the current D1-specific persistence plan with a MySQL-compatible data layer and migrations; keep reproducible deployment configuration for both Ubuntu environments.&lt;br&gt;QA + playtesting, store pages &amp; pricing, marketing, analytics, error monitoring, support, post-launch content + mod curation." vertex="1">
          <mxGeometry height="210" width="440" x="340" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="goal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontStyle=1;" value="&lt;b&gt;🏁 FINAL GOAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cross-platform (web + Steam + mobile), grandmaster Stockfish, free base + one-time CROSS-PLATFORM paid unlock (MoR, website-only), global leaderboard, and &lt;b&gt;open to modders (SDK + Steam Workshop)&lt;/b&gt;. Buy once → play everywhere." vertex="1">
          <mxGeometry height="130" width="440" x="340" y="1940" as="geometry" />
        </mxCell>
        <mxCell id="e_start_p0" edge="1" parent="1" source="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p0_p1" edge="1" parent="1" source="p0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_gate" edge="1" parent="1" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="gate1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gate_p2" edge="1" parent="1" source="gate1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;fontColor=#333333;" target="p2" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gate_p1" edge="1" parent="1" source="gate1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=1;dashed=1;fontColor=#C62828;exitX=0;exitY=0.5;entryX=0;entryY=1;" target="p1" value="not yet — tune">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2_p3" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7B1FA2;strokeWidth=2;" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2_p4" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#E65100;strokeWidth=2;" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p3_p5" edge="1" parent="1" source="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p4_p5" edge="1" parent="1" source="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p5_p6" edge="1" parent="1" source="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;strokeWidth=2;" target="p6mod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_p6" edge="1" parent="1" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#388E3C;strokeWidth=1;dashed=1;fontColor=#388E3C;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="p6mod" value="engine abstraction → engine mods">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="495" />
              <mxPoint x="1070" y="1420" />
            </Array>
            <mxPoint x="1070" y="510" as="sourcePoint" />
